(define (tm-dump in out)
  (let* ((t (tree-import (string->url in) "texmacs"))
         (s (tree->stree t)))
    (call-with-output-file out (lambda (p) (write s p)))))
(define (tm-undump in out)
  (let* ((s (call-with-input-file in (lambda (p) (read p))))
         (t (stree->tree s)))
    (tree-export t (string->url out) "texmacs")))
(define (tm-latex in out)
  (let* ((t (tree-import (string->url in) "latex")))
    (tree-export t (string->url out) "texmacs")))
(define (tm-typeset in pdf)
  ;; typeset a document, export it to pdf and save it with its references
  (let ((u (string->url in)))
    (style-clear-cache)
    (load-buffer u)
    (switch-to-buffer u)
    ;; :overwrite, otherwise headless export silently keeps an existing file
    (export-buffer-main u (string->url pdf) "pdf" (list :overwrite))
    (generate-all-aux)
    (update-current-buffer)
    (export-buffer-main u (string->url pdf) "pdf" (list :overwrite))
    (buffer-pretend-modified u)
    (buffer-save u)))
(define (tm-html in out mathjax)
  ;; export a document to html (typesetting first, so references are known)
  (let ((u (string->url in)))
    (set-preference "texmacs->html:mathjax" (if mathjax "on" "off"))
    (set-preference "texmacs->html:css" "on")
    (set-preference "texmacs->html:images" "on")
    (style-clear-cache)
    (load-buffer u)
    (switch-to-buffer u)
    (export-buffer-main u (string->url out) "html" (list :overwrite))))
