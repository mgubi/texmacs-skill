(define (collect-labels s acc)
  (if (pair? s)
      (begin
        (if (symbol? (car s)) (hash-set! acc (car s) #t))
        (for-each (lambda (x) (collect-labels x acc)) (cdr s)))))
(define (tm-tagcheck in)
  (let* ((u (string->url in)))
    (load-buffer u) (switch-to-buffer u)
    (let* ((acc (make-hash-table 100))
           (s (tree->stree (buffer-tree))))
      (collect-labels s acc)
      (display (string-append "FILE " in "\n"))
      (hash-fold (lambda (k v r)
                   (let ((n (symbol->string k)))
                     (if (not (style-has? n))
                         (display (string-append "  UNDEF " n "\n")))))
                 #f acc))))
